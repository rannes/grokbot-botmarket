{
  "name": "grokbot-botmarket",
  "version": "0.1.0",
  "description": "Self-hosted marketplace for Grok Bot bots: publish a bot, share a link, one click adds it to Grok Bot.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rannes/grokbot-botmarket.git"
  },
  "homepage": "https://github.com/rannes/grokbot-botmarket#readme",
  "bugs": "https://github.com/rannes/grokbot-botmarket/issues",
  "bin": {
    "grokbot-botmarket": "dist/index.js"
  },
  "files": [
    "dist",
    "seed",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && rm -rf dist/public && cp -R src/public dist/public",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "grok-bot",
    "grokbot",
    "marketplace",
    "self-hosted",
    "bots",
    "xai"
  ],
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "marked": "^15.0.0",
    "pg": "^8.23.1",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
